# Copy to .env.local for local development.
# Next.js only reads these at startup — restart `npm run dev` after changing them.

# Base URL of the ReFound API, including the /api suffix.
#   deployed: https://refound-api-doip.onrender.com/api
#   local:    http://localhost:8080/api
#
# When running the backend locally, the API's own APP_BASE_URL must list this
# app's origin or the browser blocks every request with a CORS error.
NEXT_PUBLIC_API_BASE_URL=https://refound-api-doip.onrender.com/api
