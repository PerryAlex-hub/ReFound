# Copy to .env and fill in. Never commit .env.

# --- Database (Neon) ---
DATABASE_URL=jdbc:postgresql://<host>.neon.tech/refound?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=

# --- Auth ---
# Generate a long random value, e.g. openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# --- Mail (Brevo, Resend, or Gmail app password for dev) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@refound.app

# --- App ---
APP_BASE_URL=http://localhost:3000
MATCH_SCORE_THRESHOLD=0.55
ITEM_EXPIRY_DAYS=90

# --- Cloudinary (item photos, claim evidence) ---
# Dashboard -> Product Environment Credentials. The secret is a real
# credential: it belongs in .env only, never in source control.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
